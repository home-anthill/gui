{
  "name": "home-anthill",
  "version": "5.0.0",
  "license": "MIT",
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "start": "npm run lint && nx dev",
    "build": "npm run lint && npm run build:dev",
    "build:dev": "npm run clean && nx build --configuration=development && npm run clean:dest && npm run copy",
    "build:prod": "npm run clean:dist && nx build --configuration=production",
    "lint": "nx lint",
    "clean": "npm run clean:dist && npm run clean:dest",
    "clean:dist": "rm -rf dist",
    "clean:dest": "rm -rf ../api-server/public",
    "copy": "cpr dist/ ../api-server/public/",
    "test": "nx test",
    "test:coverage": "npx vitest run --coverage",
    "deps": "nx migrate latest",
    "deps:apply": "nx migrate --run-migrations"
  },
  "private": true,
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@reduxjs/toolkit": "^2.13.0",
    "@tabler/icons-react": "^3.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/react": "24.0.0",
    "@nx/vite": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "24.0.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "cpr": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "2.7.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "nx": "24.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.106.1",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "5.0.5"
  }
}
