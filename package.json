{
  "name": "home-anthill",
  "version": "5.0.0",
  "license": "MIT",
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "start": "npm run lint && nx dev",
    "build": "npm run lint && npm run build:dev",
    "build:dev": "npm run clean && nx build --configuration=development && npm run clean:dest && npm run copy",
    "build:prod": "npm run clean:dist && nx build --configuration=production",
    "lint": "nx lint",
    "clean": "npm run clean:dist && npm run clean:dest",
    "clean:dist": "rm -rf dist",
    "clean:dest": "rm -rf ../api-server/public",
    "copy": "cpr dist/ ../api-server/public/",
    "test": "nx test",
    "test:coverage": "npx vitest run --coverage",
    "deps": "nx migrate latest"
  },
  "private": true,
  "dependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/react": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "cpr": "^3.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "msw": "^2.15.0",
    "nx": "23.1.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.3",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.0.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.4"
  }
